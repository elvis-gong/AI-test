/**
 * @file kernel.asc
 * @brief Ascend C implementation of SqrtSoftplusTopK for direct invocation.
 * @note Included by the supplied harness. Tensor descriptors and aclrtStream
 *       are provided by the includer; no file I/O or CPU scoring is performed here.
 */
#include <cstdint>
#include <stdexcept>
#include <string>
#include "kernel_operator.h"

namespace sqrt_topk {
using namespace AscendC;

/** @brief Preserve FP32 input values using vector arithmetic without rounding. */
__aicore__ inline void ToFloat(LocalTensor<float> dst, LocalTensor<float> src, uint32_t count) {
    Adds(dst, src, 0.0F, count);
}
/** @brief Convert FP16 input to FP32 without loss of representable input values. */
__aicore__ inline void ToFloat(LocalTensor<float> dst, LocalTensor<half> src, uint32_t count) {
    Cast(dst, src, RoundMode::CAST_NONE, count);
}
/** @brief Return the FP32 VECOUT score buffer directly, avoiding an extra vector copy. */
__aicore__ inline LocalTensor<float> FromFloat(LocalTensor<float>, LocalTensor<float> src) {
    return src;
}
/** @brief Round the final FP32 scores to FP16. */
__aicore__ inline LocalTensor<half> FromFloat(LocalTensor<half> dst, LocalTensor<float> src) {
    Cast(dst, src, RoundMode::CAST_RINT, 64);
    return dst;
}

/** @brief Synchronize producer and consumer pipelines using a reusable event. */
template <HardEvent event>
__aicore__ inline void Sync() {
    SetFlag<event>(EVENT_ID0);
    WaitFlag<event>(EVENT_ID0);
}

/**
 * @brief Row kernel with vector sorting/reduction followed by FP32 scoring.
 * @tparam T Input/output scalar type, float or half.
 * @note k=1 uses ReduceMax; other k values use Sort32 and a four-way merge tree.
 *       All UB storage is bounded by E<=1024 and k<=64, independent of T.
 */
template <typename T>
class Kernel {
public:
    /** @brief Initialize row-major GM views and aligned UB buffers. */
    __aicore__ inline void Init(GM_ADDR input, GM_ADDR output,
                               uint32_t rows, uint32_t experts, uint32_t k) {
        rows_ = rows;
        experts_ = experts;
        k_ = k;
        // Input DMA pads each UB row to a 32-byte boundary; padded lanes are ignored.
        const uint32_t elementsPerBlock = 32 / sizeof(T);
        inputCount_ = (experts + elementsPerBlock - 1) / elementsPerBlock * elementsPerBlock;
        sortCount_ = 64;
        while (sortCount_ < experts_) {
            sortCount_ *= 2;
        }
        input_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(input), rows * experts);
        output_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(output), rows * k);
        pipe_.InitBuffer(inputBuffer_, 1024 * sizeof(T));
        pipe_.InitBuffer(rowBuffer_, 1024 * sizeof(float));
        pipe_.InitBuffer(selectedBuffer_, 64 * sizeof(float));
        pipe_.InitBuffer(expBuffer_, 64 * sizeof(float));
        pipe_.InitBuffer(scoreBuffer_, 64 * sizeof(float));
        pipe_.InitBuffer(seriesBuffer_, 64 * sizeof(float));
        pipe_.InitBuffer(polynomialBuffer_, 64 * sizeof(float));
        pipe_.InitBuffer(maskBuffer_, 256);
        pipe_.InitBuffer(outputBuffer_, 256);
        if (k_ == 1) {
            // At most 16 float reduction repeats generate 32 workspace elements.
            pipe_.InitBuffer(reduceBuffer_, 64 * sizeof(float));
        } else {
            pipe_.InitBuffer(indexBuffer_, 1024 * sizeof(uint32_t));
            pipe_.InitBuffer(sortBuffer0_, 2048 * sizeof(float));
            pipe_.InitBuffer(sortBuffer1_, 2048 * sizeof(float));
            // IDs are not returned. Equal dummy IDs leave value ordering unchanged.
            Duplicate(indexBuffer_.Get<uint32_t>(), uint32_t(0), sortCount_);
            PipeBarrier<PIPE_V>();
        }
    }

    /**
     * @brief Assign balanced contiguous row ranges to logical cores.
     * @note Adjacent output rows stay on the same core except at range boundaries,
     *       limiting interleaved short writes and improving sequential GM access.
     */
    __aicore__ inline void Process() {
        const uint32_t core = GetBlockIdx();
        const uint32_t cores = GetBlockNum();
        const uint32_t base = rows_ / cores;
        const uint32_t remainder = rows_ % cores;
        const uint32_t begin = core * base + (core < remainder ? core : remainder);
        const uint32_t end = begin + base + (core < remainder ? 1 : 0);
        for (uint32_t row = begin; row < end; ++row) {
            ProcessRow(row);
        }
    }

private:
    /**
     * @brief Select the largest logits without scanning UB through Scalar.
     * @note Packed float sort entries occupy two elements: (value, uint32 index).
     *       Power-of-two padding permits uniform four-way stages and a final
     *       two-way stage. Padded values cannot exceed any finite input logit.
     */
    __aicore__ inline void Select(LocalTensor<float> row, LocalTensor<float> selected) {
        if (k_ == 1) {
            Duplicate(selected, 0.0F, 64);
            PipeBarrier<PIPE_V>();
            ReduceMax(selected, row, reduceBuffer_.Get<float>(), experts_, false);
            Sync<HardEvent::V_S>();
            maximum_ = selected.GetValue(0);
            minimum_ = maximum_;
            return;
        }
        auto source = sortBuffer0_.Get<float>();
        auto destination = sortBuffer1_.Get<float>();
        Duplicate(selected, 0.0F, 64);
        Sort32(source, row, indexBuffer_.Get<uint32_t>(), sortCount_ / 32);
        PipeBarrier<PIPE_V>();
        for (uint32_t length = 32; length < sortCount_;) {
            const uint32_t lists = sortCount_ / length;
            const uint32_t fanIn = lists >= 4 ? 4 : 2;
            MrgSortSrcList<float> sources;
            sources.src1 = source;
            sources.src2 = source[2 * length];
            if (fanIn == 4) {
                sources.src3 = source[4 * length];
                sources.src4 = source[6 * length];
            }
            MrgSort4Info params;
            for (uint32_t j = 0; j < 4; ++j) {
                params.elementLengths[j] = j < fanIn ? length : 0;
            }
            params.ifExhaustedSuspension = false;
            params.validBit = fanIn == 4 ? 0b1111 : 0b0011;
            // Consecutive equal-size four-list groups can be merged in one call.
            params.repeatTimes = lists / fanIn;
            MrgSort(destination, sources, params);
            PipeBarrier<PIPE_V>();
            auto swap = source;
            source = destination;
            destination = swap;
            length *= fanIn;
        }
        Sync<HardEvent::V_S>();
        // Only k values cross into Scalar, instead of E*k insertion operations.
        for (uint32_t j = 0; j < k_; ++j) {
            selected.SetValue(j, source.GetValue(2 * j));
        }
        maximum_ = source.GetValue(0);
        minimum_ = source.GetValue(2 * (k_ - 1));
    }

    /**
     * @brief Evaluate stable softplus and sqrt for the selected logits.
     * @note For x<-2, an eight-term log1p series avoids cancellation in ln(1+z).
     *       With z<=exp(-2), its relative truncation error is below 2e-8.
     *       Device instruction errors must still be checked against the golden.
     */
    __aicore__ inline void Score(LocalTensor<float> selected) {
        auto exponential = expBuffer_.Get<float>();
        auto scores = scoreBuffer_.Get<float>();
        auto series = seriesBuffer_.Get<float>();
        auto polynomial = polynomialBuffer_.Get<float>();
        auto mask = maskBuffer_.Get<uint8_t>();
        // Complete Scalar extraction/bounds before Vector reads selected values.
        Sync<HardEvent::S_V>();
        if (minimum_ > 20.0F) {
            // All valid values use softplus(x)=x; no exponential or logarithm.
            Sqrt(scores, selected, 64);
            PipeBarrier<PIPE_V>();
            return;
        }
        if (maximum_ > 20.0F) {
            Mins(exponential, selected, 20.0F, 64);
            PipeBarrier<PIPE_V>();
            Exp(exponential, exponential, 64);
        } else {
            Exp(exponential, selected, 64);
        }
        PipeBarrier<PIPE_V>();
        if (maximum_ >= -2.0F) {
            Adds(scores, exponential, 1.0F, 64);
            PipeBarrier<PIPE_V>();
            Ln(scores, scores, 64);
            PipeBarrier<PIPE_V>();
        }
        if (minimum_ >= -2.0F && maximum_ <= 20.0F) {
            // Typical positive top-k scores need no series or branch selection.
            Sqrt(scores, scores, 64);
            PipeBarrier<PIPE_V>();
            return;
        }

        if (minimum_ < -2.0F) {
            // Restrict the series argument even in lanes where the series is unused.
            Mins(series, exponential, 0.1353352832366127F, 64);
            Duplicate(polynomial, -1.0F / 8.0F, 64);
            PipeBarrier<PIPE_V>();
            for (int32_t power = 7; power >= 2; --power) {
                const float coefficient = (power % 2 == 0 ? -1.0F : 1.0F) / power;
                Mul(polynomial, polynomial, series, 64);
                PipeBarrier<PIPE_V>();
                Adds(polynomial, polynomial, coefficient, 64);
                PipeBarrier<PIPE_V>();
            }
            Mul(polynomial, polynomial, series, 64);
            PipeBarrier<PIPE_V>();
            Adds(polynomial, polynomial, 1.0F, 64);
            PipeBarrier<PIPE_V>();
            Mul(polynomial, polynomial, series, 64);
            PipeBarrier<PIPE_V>();
            if (maximum_ < -2.0F) {
                // All valid values use the series; padded lanes are never written out.
                Adds(scores, polynomial, 0.0F, 64);
                PipeBarrier<PIPE_V>();
            } else {
                CompareScalar(mask, selected, -2.0F, CMPMODE::LT, 64);
                PipeBarrier<PIPE_V>();
                AscendC::Select(scores, mask, polynomial, scores,
                               SELMODE::VSEL_TENSOR_TENSOR_MODE, 64);
                PipeBarrier<PIPE_V>();
            }
        }
        if (maximum_ > 20.0F) {
            CompareScalar(mask, selected, 20.0F, CMPMODE::GT, 64);
            PipeBarrier<PIPE_V>();
            AscendC::Select(scores, mask, selected, scores,
                           SELMODE::VSEL_TENSOR_TENSOR_MODE, 64);
            PipeBarrier<PIPE_V>();
        }
        Sqrt(scores, scores, 64);
        PipeBarrier<PIPE_V>();
    }

    /**
     * @brief Load exactly E elements from an arbitrary row start and write k scores.
     * @note GM rows need not be 32-byte aligned when E is not a power of two.
     *       Reduction reads E values; sorting fills every padded lane with a minimum sentinel.
     */
    __aicore__ inline void ProcessRow(uint32_t rowIndex) {
        auto input = inputBuffer_.Get<T>();
        auto row = rowBuffer_.Get<float>();
        auto selected = selectedBuffer_.Get<float>();
        auto output = outputBuffer_.Get<T>();
        if (k_ != 1) {
            Duplicate(row, -3.4028234663852886e38F, sortCount_);
            PipeBarrier<PIPE_V>();
        }
        Sync<HardEvent::S_MTE2>();
        DataCopyExtParams inputCopy{1, static_cast<uint32_t>(experts_ * sizeof(T)), 0, 0, 0};
        DataCopyPadExtParams<T> padding{true, 0,
            static_cast<uint8_t>(inputCount_ - experts_), static_cast<T>(0)};
        DataCopyPad(input, input_[rowIndex * experts_], inputCopy, padding);
        Sync<HardEvent::MTE2_V>();
        ToFloat(row, input, inputCount_);
        PipeBarrier<PIPE_V>();
        if (k_ != 1 && experts_ != inputCount_) {
            // Conversion includes DMA padding, which must not outrank negative logits.
            Sync<HardEvent::V_S>();
            for (uint32_t j = experts_; j < inputCount_; ++j) {
                row.SetValue(j, -3.4028234663852886e38F);
            }
            Sync<HardEvent::S_V>();
        }
        Select(row, selected);
        Score(selected);
        auto readyOutput = FromFloat(output, scoreBuffer_.Get<float>());
        Sync<HardEvent::V_MTE3>();
        // Byte-counted DMA handles k=1/6 and unaligned row starts without overwrite.
        DataCopyExtParams copy{1, static_cast<uint32_t>(k_ * sizeof(T)), 0, 0, 0};
        DataCopyPad(output_[rowIndex * k_], readyOutput, copy);
        // MTE3->S->MTE2->V on the next row also protects VECOUT reuse.
        Sync<HardEvent::MTE3_S>();
    }

    TPipe pipe_;
    TBuf<TPosition::VECIN> inputBuffer_;
    TBuf<TPosition::VECCALC> rowBuffer_, selectedBuffer_, expBuffer_;
    TBuf<TPosition::VECCALC> indexBuffer_, sortBuffer0_, sortBuffer1_, reduceBuffer_;
    TBuf<TPosition::VECOUT> scoreBuffer_;
    TBuf<TPosition::VECCALC> seriesBuffer_, polynomialBuffer_, maskBuffer_;
    TBuf<TPosition::VECOUT> outputBuffer_;
    GlobalTensor<T> input_, output_;
    uint32_t rows_, experts_, k_, inputCount_, sortCount_;
    float minimum_, maximum_;
};
}  // namespace sqrt_topk

/** @brief Direct-invocation vector-core entry point for one supported dtype. */
template <typename T>
__global__ __vector__ void sqrt_softplus_top_k_custom(
    GM_ADDR input, GM_ADDR output, uint32_t rows, uint32_t experts, uint32_t k) {
    sqrt_topk::Kernel<T> kernel;
    kernel.Init(input, output, rows, experts, k);
    kernel.Process();
}

/**
 * @brief Validate the supplied tensor descriptors and launch the dtype-specific kernel.
 * @throws std::invalid_argument If descriptors violate the contest contract.
 * @note The caller owns buffers, stream lifetime, and post-launch synchronization.
 */
extern "C" void run_kernel(GM_ADDR router_logits, const TensorGroupInfo& info_router_logits,
                           GM_ADDR topk_scores, const TensorGroupInfo& info_topk_scores,
                           int64_t availableCoreNum, aclrtStream stream, int64_t k) {
    if (!router_logits || !topk_scores || !info_router_logits.tensors ||
        !info_topk_scores.tensors || info_router_logits.numTensors != 1 ||
        info_topk_scores.numTensors != 1 || availableCoreNum <= 0) {
        throw std::invalid_argument("invalid buffers, tensor groups, or core count");
    }
    const auto& x = info_router_logits.tensors[0];
    const auto& y = info_topk_scores.tensors[0];
    if (!x.shape || !y.shape || x.numDims != 2 || y.numDims != 2) {
        throw std::invalid_argument("expected two-dimensional tensors");
    }
    const int64_t rows = x.shape[0], experts = x.shape[1];
    if (rows < 1 || rows > 131072 || experts < 64 || experts > 1024 ||
        k < 1 || k > 64 || k > experts ||
        (x.dtype != 0 && x.dtype != 1) || y.dtype != x.dtype ||
        y.shape[0] != rows || y.shape[1] != k) {
        throw std::invalid_argument(
            "unsupported SqrtSoftplusTopK contract: T=" + std::to_string(rows) +
            ", E=" + std::to_string(experts) + ", k=" + std::to_string(k) +
            ", input_dtype=" + std::to_string(x.dtype) +
            ", output_dtype=" + std::to_string(y.dtype) +
            ", output_shape=(" + std::to_string(y.shape[0]) + "," +
            std::to_string(y.shape[1]) + ")");
    }
    const uint32_t blocks = static_cast<uint32_t>(rows < availableCoreNum ? rows : availableCoreNum);
    if (x.dtype == 0) {
        sqrt_softplus_top_k_custom<float><<<blocks, nullptr, stream>>>(
            router_logits, topk_scores, rows, experts, k);
    } else {
        sqrt_softplus_top_k_custom<half><<<blocks, nullptr, stream>>>(
            router_logits, topk_scores, rows, experts, k);
    }
}
