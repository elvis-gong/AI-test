/**
 * @file kernel.asc
 * @brief Ascend C SqrtSoftplusTopK: tiled reduction or exact pruned top-k merging.
 * @note Included by the provided direct-invocation harness; no CPU scoring or I/O.
 */
#include <cstdint>
#include <stdexcept>
#include <string>
#include "kernel_operator.h"

namespace sqrt_topk {
using namespace AscendC;

/** @brief Keep FP32 results in VECOUT without a copy. */
__aicore__ inline LocalTensor<float> OutputFloat(LocalTensor<float>, LocalTensor<float> src, uint32_t) {
    return src;
}
/** @brief Convert only the final scoring tile to the input FP16 dtype. */
__aicore__ inline LocalTensor<half> OutputFloat(LocalTensor<half> dst, LocalTensor<float> src, uint32_t count) {
    Cast(dst, src, RoundMode::CAST_RINT, count);
    return dst;
}
/** @brief Round an element/byte count up to the supplied alignment. */
__aicore__ inline uint32_t Align(uint32_t count, uint32_t alignment) {
    return (count + alignment - 1) / alignment * alignment;
}

/** @brief Synchronize producer and consumer pipelines using a reusable event. */
template <HardEvent event>
__aicore__ inline void Sync() {
    SetFlag<event>(EVENT_ID0);
    WaitFlag<event>(EVENT_ID0);
}

/**
 * @brief Score contiguous FP32 lanes using only the numerical branches required.
 * @param count Number of lanes; a multiple of 64 for CompareScalar alignment.
 * @param minimum Minimum selected logit, including harmless tile padding.
 * @param maximum Maximum selected logit, including harmless tile padding.
 * @note The caller supplies aligned scratch buffers and checks device accuracy.
 */
__aicore__ inline void ScoreValues(LocalTensor<float> selected, LocalTensor<float> scores,
                                 LocalTensor<float> exponential, LocalTensor<float> series,
                                 LocalTensor<float> polynomial, LocalTensor<uint8_t> mask,
                                 uint32_t count, float minimum, float maximum) {
    Sync<HardEvent::S_V>();
    if (minimum >= -2.0F && maximum <= 20.0F) {
        Exp(exponential, selected, count);
        PipeBarrier<PIPE_V>();
        Adds(scores, exponential, 1.0F, count);
        PipeBarrier<PIPE_V>();
        Ln(scores, scores, count);
        PipeBarrier<PIPE_V>();
        Sqrt(scores, scores, count);
        PipeBarrier<PIPE_V>();
        return;
    }
    if (minimum > 20.0F) {
        Sqrt(scores, selected, count);
        PipeBarrier<PIPE_V>();
        return;
    }
    Mins(exponential, selected, 20.0F, count);
    PipeBarrier<PIPE_V>();
    Exp(exponential, exponential, count);
    PipeBarrier<PIPE_V>();
    Adds(scores, exponential, 1.0F, count);
    PipeBarrier<PIPE_V>();
    Ln(scores, scores, count);
    PipeBarrier<PIPE_V>();
    if (minimum < -2.0F) {
        Mins(series, exponential, 0.1353352832366127F, count);
        Duplicate(polynomial, -1.0F / 8.0F, count);
        PipeBarrier<PIPE_V>();
        for (int32_t power = 7; power >= 2; --power) {
            Mul(polynomial, polynomial, series, count);
            PipeBarrier<PIPE_V>();
            Adds(polynomial, polynomial, (power % 2 == 0 ? -1.0F : 1.0F) / power, count);
            PipeBarrier<PIPE_V>();
        }
        Mul(polynomial, polynomial, series, count);
        PipeBarrier<PIPE_V>();
        Adds(polynomial, polynomial, 1.0F, count);
        PipeBarrier<PIPE_V>();
        Mul(polynomial, polynomial, series, count);
        PipeBarrier<PIPE_V>();
        CompareScalar(mask, selected, -2.0F, CMPMODE::LT, count);
        PipeBarrier<PIPE_V>();
        AscendC::Select(scores, mask, polynomial, scores, SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
        PipeBarrier<PIPE_V>();
    }
    if (maximum > 20.0F) {
        CompareScalar(mask, selected, 20.0F, CMPMODE::GT, count);
        PipeBarrier<PIPE_V>();
        AscendC::Select(scores, mask, selected, scores, SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
        PipeBarrier<PIPE_V>();
    }
    Sqrt(scores, scores, count);
    PipeBarrier<PIPE_V>();
}

/** @brief Reuse FP32 input directly; the unused conversion buffer stays untouched. */
__aicore__ inline LocalTensor<float> InputFloat(LocalTensor<float>, LocalTensor<float> src,
                                             uint32_t) {
    return src;
}
/** @brief Convert an entire FP16 input tile to FP32 in one vector operation. */
__aicore__ inline LocalTensor<float> InputFloat(LocalTensor<float> dst, LocalTensor<half> src,
                                             uint32_t count) {
    Cast(dst, src, RoundMode::CAST_NONE, count);
    return dst;
}
/** @brief Finite padding sentinel in the input's representable range. */
__aicore__ inline float PaddingValue(float) { return -3.4028234663852886e38F; }
__aicore__ inline half PaddingValue(half) { return static_cast<half>(-65504.0F); }

/** @brief Copy geometry for compacting the useful prefix of sorted lists. */
struct PrefixPlan {
    CopyRepeatParams stride;
    uint8_t repeats;
    uint8_t firstMask;
    uint8_t secondMask;
};
/** @brief Shape-dependent merge geometry, computed once rather than in the tile loop. */
struct MergePlan {
    MrgSort4Info params;
    PrefixPlan prefix;
    uint32_t listLength;
    bool prune;
};

/**
 * @brief Unified one-row/multi-row kernel; MaxOnly removes sorting at compile time.
 * @tparam T Float or half input/output type.
 * @tparam MaxOnly True for k=1, false for the pruned merge selection algorithm.
 * @note A discarded item has at least k preceding items in its own sorted list.
 *       It cannot improve the global top-k values, including equal-value ties.
 */
template <typename T, bool MaxOnly>
class Kernel {
public:
    /** @brief Prepare fixed DMA geometry, merge plans, offsets and bounded UB buffers. */
    __aicore__ inline void Init(GM_ADDR input, GM_ADDR output,
                               uint32_t rows, uint32_t experts, uint32_t k) {
        rows_ = rows; experts_ = experts; k_ = k;
        sortCount_ = 64;
        while (sortCount_ < experts_) sortCount_ *= 2;
        keep_ = Align(k_, 8);
        baseKeep_ = keep_ < 32 ? keep_ : 32;
        scoreStride_ = Align(k_, 16);
        const uint32_t limit = MaxOnly ? (sortCount_ == 1024 ? 8 : 16)
                                      : (4096 / sortCount_ < 16 ? 4096 / sortCount_ : 16);
        tileRows_ = 1;
        const uint32_t perCore = rows_ / GetBlockNum();
        while (tileRows_ * 2 <= limit && tileRows_ * 2 <= perCore &&
               BufferBytes(tileRows_ * 2) <= 120 * 1024) tileRows_ *= 2;
        inputCount_ = tileRows_ * sortCount_;
        scoreCount_ = Align(tileRows_ * scoreStride_, 64);
        input_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(input), rows_ * experts_);
        output_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(output), rows_ * k_);
        pipe_.InitBuffer(inputBuffer_, Align(inputCount_ * sizeof(T), 256));
        pipe_.InitBuffer(floatBuffer_, sizeof(T) == 2 ? inputCount_ * sizeof(float) : 256);
        pipe_.InitBuffer(selectedBuffer_, scoreCount_ * sizeof(float));
        pipe_.InitBuffer(offsetBuffer_, scoreCount_ * sizeof(uint32_t));
        pipe_.InitBuffer(expBuffer_, scoreCount_ * sizeof(float));
        pipe_.InitBuffer(seriesBuffer_, scoreCount_ * sizeof(float));
        pipe_.InitBuffer(polynomialBuffer_, scoreCount_ * sizeof(float));
        pipe_.InitBuffer(scoreBuffer_, scoreCount_ * sizeof(float));
        pipe_.InitBuffer(outputBuffer_, Align(scoreCount_ * sizeof(T), 256));
        pipe_.InitBuffer(maskBuffer_, 256);
        pipe_.InitBuffer(boundsBuffer_, 256);
        pipe_.InitBuffer(reduceBuffer_, 256);
        if (!MaxOnly) {
            pipe_.InitBuffer(indexBuffer_, inputCount_ * sizeof(uint32_t));
            pipe_.InitBuffer(sortBuffer0_, inputCount_ * 8);
            pipe_.InitBuffer(sortBuffer1_, CompactBytes(tileRows_));
            PrepareMerges();
        } else {
            const uint32_t blocks = sortCount_ / 64;
            partialSpacing_ = blocks < 8 ? 8 / blocks : 1;
            partialRowBlocks_ = blocks < 8 ? 1 : blocks / 8;
            partialMask_[0] = 0; partialMask_[1] = 0;
            for (uint32_t j = 0; j < blocks; ++j)
                partialMask_[0] |= uint64_t(1) << (j * partialSpacing_);
        }
        PrepareOffsets();
        const uint32_t alignedE = Align(experts_, 32 / sizeof(T));
        copyIn_ = {0, static_cast<uint32_t>(experts_ * sizeof(T)), 0,
                   static_cast<uint32_t>((sortCount_ - alignedE) * sizeof(T) / 32), 0};
        const T sentinel = PaddingValue(static_cast<T>(0));
        padding_ = {true, 0, static_cast<uint8_t>(alignedE - experts_), sentinel};
        copyOut_ = {0, static_cast<uint32_t>(k_ * sizeof(T)),
                    static_cast<uint32_t>((scoreStride_ * sizeof(T) - Align(k_ * sizeof(T), 32)) / 32), 0, 0};
        // Input is read-only in all computation. Initialize padding only once.
        Duplicate(inputBuffer_.Get<T>(), sentinel, inputCount_);
        PipeBarrier<PIPE_V>();
    }

    /** @brief Process balanced contiguous core ranges, writing only actual tail rows. */
    __aicore__ inline void Process() {
        const uint32_t core = GetBlockIdx(), cores = GetBlockNum();
        const uint32_t base = rows_ / cores, extra = rows_ % cores;
        const uint32_t begin = core * base + (core < extra ? core : extra);
        const uint32_t end = begin + base + (core < extra ? 1 : 0);
        for (uint32_t row = begin; row < end; row += tileRows_)
            ProcessTile(row, end - row < tileRows_ ? end - row : tileRows_);
    }

private:
    /** @brief Storage needed by the smaller ping-pong buffer; Gather count also fits. */
    __aicore__ inline uint32_t CompactBytes(uint32_t tileRows) const {
        const uint32_t prefixBytes = tileRows * sortCount_ * 8 * baseKeep_ / 32;
        const uint32_t gatherBytes = Align(tileRows * scoreStride_, 64) * 4;
        return Align(prefixBytes > gatherBytes ? prefixBytes : gatherBytes, 256);
    }
    /** @brief Exact tensor-storage budget, excluding the compiler's metadata. */
    __aicore__ inline uint32_t BufferBytes(uint32_t tileRows) const {
        const uint32_t inputs = tileRows * sortCount_, scores = Align(tileRows * scoreStride_, 64);
        uint32_t bytes = Align(inputs * sizeof(T), 256) + (sizeof(T) == 2 ? inputs * 4 : 256)
                       + scores * 24 + Align(scores * sizeof(T), 256) + 768;
        if (!MaxOnly) bytes += inputs * 12 + CompactBytes(tileRows);
        return bytes;
    }
    /** @brief Plan a strided vector Copy for the first kept entries of every list. */
    __aicore__ inline PrefixPlan Prefix(uint32_t sourceLength, uint32_t kept, uint32_t lists) {
        PrefixPlan plan;
        plan.stride.dstStride = 1; plan.stride.srcStride = 1;
        plan.stride.dstRepeatSize = kept / 4; plan.stride.srcRepeatSize = sourceLength / 4;
        plan.repeats = static_cast<uint8_t>(tileRows_ * lists);
        plan.firstMask = static_cast<uint8_t>(kept > 32 ? 64 : 2 * kept);
        plan.secondMask = static_cast<uint8_t>(kept > 32 ? 2 * kept - 64 : 0);
        return plan;
    }
    /** @brief Build at most three four-way stages; split a final pair into four halves. */
    __aicore__ inline void PrepareMerges() {
        uint32_t groups = sortCount_ / 32, length = baseKeep_;
        initial_ = Prefix(32, baseKeep_, groups);
        stages_ = 0;
        while (groups > 1) {
            const uint32_t fan = groups >= 4 ? 4 : 2;
            MergePlan& plan = merge_[stages_++];
            plan.listLength = fan == 4 ? length : length / 2;
            groups /= fan;
            for (uint32_t j = 0; j < 4; ++j) plan.params.elementLengths[j] = plan.listLength;
            plan.params.ifExhaustedSuspension = false;
            plan.params.validBit = 0b1111;
            plan.params.repeatTimes = tileRows_ * groups;
            length *= fan;
            plan.prune = groups > 1 && length > keep_;
            if (plan.prune) {
                plan.prefix = Prefix(length, keep_, groups);
                length = keep_;
            }
        }
        resultLength_ = length;
    }
    /** @brief Generate one offset row and expand it using integer vector arithmetic. */
    __aicore__ inline void PrepareOffsets() {
        auto offsets = offsetBuffer_.Get<int32_t>();
        if (MaxOnly) {
            Duplicate(offsets, int32_t(0), scoreCount_);
            PipeBarrier<PIPE_V>();
        } else {
            for (uint32_t j = 0; j < scoreStride_; ++j)
                offsets.SetValue(j, static_cast<int32_t>((j < k_ ? j : k_ - 1) * 8));
            Sync<HardEvent::S_V>();
        }
        const uint32_t rowBytes = MaxOnly ? scoreStride_ * 4 : resultLength_ * 8;
        for (uint32_t r = 1; r < tileRows_; ++r)
            Adds(offsets[r * scoreStride_], offsets, static_cast<int32_t>(r * rowBytes), scoreStride_);
        const uint32_t actual = tileRows_ * scoreStride_;
        if (actual < scoreCount_)
            Duplicate(offsets[actual], static_cast<int32_t>(MaxOnly ? 0 : (k_ - 1) * 8), scoreCount_ - actual);
        if (!MaxOnly) Duplicate(indexBuffer_.Get<uint32_t>(), uint32_t(0), inputCount_);
        PipeBarrier<PIPE_V>();
    }
    /** @brief Compact packed value/index prefixes without Scalar reads or offset tables. */
    __aicore__ inline void Compact(LocalTensor<float> dst, LocalTensor<float> src, const PrefixPlan& plan) {
        Copy(dst, src, static_cast<uint64_t>(plan.firstMask), plan.repeats, plan.stride);
        if (plan.secondMask)
            Copy(dst[64], src[64], static_cast<uint64_t>(plan.secondMask), plan.repeats, plan.stride);
        PipeBarrier<PIPE_V>();
    }
    /** @brief Reduce rows or perform exact top-k pruning after each useful merge stage. */
    __aicore__ inline void SelectTile(LocalTensor<float> rows, LocalTensor<float> selected) {
        if (MaxOnly) {
            auto maxima = expBuffer_.Get<float>();
            if (sortCount_ == 64) {
                WholeReduceMax(maxima, rows, 64, tileRows_, scoreStride_, 1, 8,
                               ReduceOrder::ORDER_ONLY_VALUE);
                PipeBarrier<PIPE_V>();
            } else {
                // First reduce each 64-lane block; sparse destinations align every row.
                auto partials = seriesBuffer_.Get<float>();
                WholeReduceMax(partials, rows, 64, inputCount_ / 64, partialSpacing_, 1, 8,
                               ReduceOrder::ORDER_ONLY_VALUE);
                PipeBarrier<PIPE_V>();
                // Then reduce each row's block maxima in a single repeated instruction.
                WholeReduceMax(maxima, partials, partialMask_, tileRows_, scoreStride_, 1,
                               partialRowBlocks_, ReduceOrder::ORDER_ONLY_VALUE);
                PipeBarrier<PIPE_V>();
            }
            Gather(selected, maxima, offsetBuffer_.Get<uint32_t>(), uint32_t(0), scoreCount_);
        } else {
            auto src = sortBuffer0_.Get<float>(), dst = sortBuffer1_.Get<float>();
            Sort32(src, rows, indexBuffer_.Get<uint32_t>(), inputCount_ / 32);
            PipeBarrier<PIPE_V>();
            if (baseKeep_ < 32) {
                Compact(dst, src, initial_);
                auto swap = src; src = dst; dst = swap;
            }
            for (uint32_t stage = 0; stage < stages_; ++stage) {
                const MergePlan& plan = merge_[stage];
                MrgSortSrcList<float> lists;
                lists.src1 = src; lists.src2 = src[2 * plan.listLength];
                lists.src3 = src[4 * plan.listLength]; lists.src4 = src[6 * plan.listLength];
                MrgSort(dst, lists, plan.params);
                PipeBarrier<PIPE_V>();
                auto swap = src; src = dst; dst = swap;
                if (plan.prune) {
                    Compact(dst, src, plan.prefix);
                    swap = src; src = dst; dst = swap;
                }
            }
            Gather(selected, src, offsetBuffer_.Get<uint32_t>(), uint32_t(0), scoreCount_);
        }
        PipeBarrier<PIPE_V>();
    }
    /** @brief Execute one tile using precomputed transfer geometry and shared FP32 scoring. */
    __aicore__ inline void ProcessTile(uint32_t firstRow, uint32_t validRows) {
        Sync<HardEvent::V_MTE2>();
        copyIn_.blockCount = static_cast<uint16_t>(validRows);
        DataCopyPad(inputBuffer_.Get<T>(), input_[firstRow * experts_], copyIn_, padding_);
        Sync<HardEvent::MTE2_V>();
        auto rows = InputFloat(floatBuffer_.Get<float>(), inputBuffer_.Get<T>(), inputCount_);
        PipeBarrier<PIPE_V>();
        auto selected = selectedBuffer_.Get<float>();
        SelectTile(rows, selected);
        auto bounds = boundsBuffer_.Get<float>();
        if (tileRows_ != 1) {
            ReduceMax(bounds, selected, reduceBuffer_.Get<float>(), scoreCount_, false);
            PipeBarrier<PIPE_V>();
            ReduceMin(bounds[2], selected, reduceBuffer_.Get<float>(), scoreCount_, false);
        }
        Sync<HardEvent::V_S>();
        const float maximum = tileRows_ == 1 ? selected.GetValue(0) : bounds.GetValue(0);
        const float minimum = tileRows_ == 1 ? selected.GetValue(k_ - 1) : bounds.GetValue(2);
        auto scores = scoreBuffer_.Get<float>();
        ScoreValues(selected, scores, expBuffer_.Get<float>(), seriesBuffer_.Get<float>(),
                    polynomialBuffer_.Get<float>(), maskBuffer_.Get<uint8_t>(), scoreCount_, minimum, maximum);
        auto ready = OutputFloat(outputBuffer_.Get<T>(), scores, scoreCount_);
        Sync<HardEvent::V_MTE3>();
        copyOut_.blockCount = static_cast<uint16_t>(validRows);
        DataCopyPad(output_[firstRow * k_], ready, copyOut_);
        Sync<HardEvent::MTE3_V>();
    }

    TPipe pipe_;
    TBuf<TPosition::VECIN> inputBuffer_;
    TBuf<TPosition::VECCALC> floatBuffer_, selectedBuffer_, offsetBuffer_, indexBuffer_;
    TBuf<TPosition::VECCALC> sortBuffer0_, expBuffer_, seriesBuffer_, polynomialBuffer_;
    TBuf<TPosition::VECCALC> maskBuffer_, boundsBuffer_, reduceBuffer_;
    TBuf<TPosition::VECOUT> sortBuffer1_, scoreBuffer_, outputBuffer_;
    GlobalTensor<T> input_, output_;
    DataCopyExtParams copyIn_, copyOut_;
    DataCopyPadExtParams<T> padding_;
    PrefixPlan initial_;
    MergePlan merge_[3];
    uint32_t rows_, experts_, k_, sortCount_, keep_, baseKeep_, tileRows_, scoreStride_;
    uint32_t inputCount_, scoreCount_, stages_, resultLength_;
    uint32_t partialSpacing_, partialRowBlocks_;
    uint64_t partialMask_[2];
};
}  // namespace sqrt_topk

/** @brief Preserve the direct-invocation ABI, selecting k=1 specialization once per launch. */
template <typename T>
__global__ __vector__ void sqrt_softplus_top_k_custom(
    GM_ADDR input, GM_ADDR output, uint32_t rows, uint32_t experts, uint32_t k) {
    if (k == 1) {
        sqrt_topk::Kernel<T, true> kernel;
        kernel.Init(input, output, rows, experts, k);
        kernel.Process();
    } else {
        sqrt_topk::Kernel<T, false> kernel;
        kernel.Init(input, output, rows, experts, k);
        kernel.Process();
    }
}

/**
 * @brief Validate the supplied tensor descriptors and launch the dtype-specific kernel.
 * @throws std::invalid_argument If descriptors violate the contest contract.
 * @note The caller owns buffers, stream lifetime, and post-launch synchronization.
 */
extern "C" void run_kernel(GM_ADDR router_logits, const TensorGroupInfo& info_router_logits,
                           GM_ADDR topk_scores, const TensorGroupInfo& info_topk_scores,
                           int64_t availableCoreNum, aclrtStream stream, int64_t k) {
    if (!router_logits || !topk_scores || !info_router_logits.tensors ||
        !info_topk_scores.tensors || info_router_logits.numTensors != 1 ||
        info_topk_scores.numTensors != 1 || availableCoreNum <= 0) {
        throw std::invalid_argument("invalid buffers, tensor groups, or core count");
    }
    const auto& x = info_router_logits.tensors[0];
    const auto& y = info_topk_scores.tensors[0];
    if (!x.shape || !y.shape || x.numDims != 2 || y.numDims != 2) {
        throw std::invalid_argument("expected two-dimensional tensors");
    }
    const int64_t rows = x.shape[0], experts = x.shape[1];
    if (rows < 1 || rows > 131072 || experts < 64 || experts > 1024 ||
        k < 1 || k > 64 || k > experts ||
        (x.dtype != 0 && x.dtype != 1) || y.dtype != x.dtype ||
        y.shape[0] != rows || y.shape[1] != k) {
        throw std::invalid_argument(
            "unsupported SqrtSoftplusTopK contract: T=" + std::to_string(rows) +
            ", E=" + std::to_string(experts) + ", k=" + std::to_string(k) +
            ", input_dtype=" + std::to_string(x.dtype) +
            ", output_dtype=" + std::to_string(y.dtype) +
            ", output_shape=(" + std::to_string(y.shape[0]) + "," +
            std::to_string(y.shape[1]) + ")");
    }
    const uint32_t blocks = static_cast<uint32_t>(rows < availableCoreNum ? rows : availableCoreNum);
    if (x.dtype == 0) {
        sqrt_softplus_top_k_custom<float><<<blocks, nullptr, stream>>>(
            router_logits, topk_scores, rows, experts, k);
    } else {
        sqrt_softplus_top_k_custom<half><<<blocks, nullptr, stream>>>(
            router_logits, topk_scores, rows, experts, k);
    }
}
