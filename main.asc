// Local test main — runs the first test case
// Usage: ./sqrt_softplus_top_k_custom

#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cmath>
#include "acl/acl.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
// Dtype enum for TensorInfo.dtype:
// 0=float32 1=float16 2=bfloat16 3=int8 4=int16 5=int32 6=int64
// 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include <vector>
#include "data_utils.h"

#define ACL_CHECK(expr) do { aclError _ret = (expr); if (_ret != 0) { fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__, _ret); return 1; } } while(0)
#define FILE_CHECK(expr) do { if (!(expr)) { fprintf(stderr, "[ERROR] File I/O failed at %s:%d\n", __FILE__, __LINE__); return 1; } } while(0)

#include "kernel.asc"

int main()
{
    int32_t deviceId = 0;
    int64_t availableCoreNum = 0;
    aclrtStream stream = nullptr;

    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(deviceId));
    ACL_CHECK(aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum));
    if (availableCoreNum <= 0) {
        return 1;
    }
    ACL_CHECK(aclrtCreateStream(&stream));

    int64_t router_logits_0_shape[] = {8, 64};
    TensorInfo router_logits_tensors[] = {{router_logits_0_shape, 2, 0}};
    TensorGroupInfo info_router_logits = {router_logits_tensors, 1};
    int64_t topk_scores_0_shape[] = {8, 4};
    TensorInfo topk_scores_tensors[] = {{topk_scores_0_shape, 2, 0}};
    TensorGroupInfo info_topk_scores = {topk_scores_tensors, 1};

    int64_t k = 4;

    uint8_t *inputHost_router_logits = nullptr, *inputDevice_router_logits = nullptr;

    uint8_t *outputHost_topk_scores = nullptr, *outputDevice_topk_scores = nullptr;

    ACL_CHECK(aclrtMallocHost((void **)&inputHost_router_logits, 2048));
    ACL_CHECK(aclrtMalloc((void **)&inputDevice_router_logits, 2048, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile("./input/router_logits.bin", 2048, inputHost_router_logits, 2048));
    ACL_CHECK(aclrtMemcpy(inputDevice_router_logits, 2048, inputHost_router_logits, 2048, ACL_MEMCPY_HOST_TO_DEVICE));

    ACL_CHECK(aclrtMallocHost((void **)&outputHost_topk_scores, 128));
    ACL_CHECK(aclrtMalloc((void **)&outputDevice_topk_scores, 128, ACL_MEM_MALLOC_HUGE_FIRST));

    run_kernel((GM_ADDR)inputDevice_router_logits, info_router_logits, (GM_ADDR)outputDevice_topk_scores, info_topk_scores, availableCoreNum, stream, k);
    auto sync_ret_ = aclrtSynchronizeStreamWithTimeout(stream, 3000);
    if (sync_ret_ != 0) { fprintf(stderr, "[ERROR] aclrtSynchronizeStreamWithTimeout failed, ret=%d\n", sync_ret_); return 1; }

    ACL_CHECK(aclrtMemcpy(outputHost_topk_scores, 128, outputDevice_topk_scores, 128, ACL_MEMCPY_DEVICE_TO_HOST));
    FILE_CHECK(WriteFile("./output/topk_scores.bin", outputHost_topk_scores, 128));

    if (inputDevice_router_logits) aclrtFree(inputDevice_router_logits);
    if (inputHost_router_logits) aclrtFreeHost(inputHost_router_logits);
    if (outputDevice_topk_scores) aclrtFree(outputDevice_topk_scores);
    if (outputHost_topk_scores) aclrtFreeHost(outputHost_topk_scores);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
